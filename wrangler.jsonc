{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "color-clash",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GameRoom" },
      { "name": "LF_ROOMS", "class_name": "LetterRoom" },
      { "name": "RM_ROOMS", "class_name": "RummyRoom" },
      { "name": "DR_ROOMS", "class_name": "DealRoom" },
      { "name": "DD_ROOMS", "class_name": "DiceRoom" },
      { "name": "BOARD", "class_name": "Board" },
      { "name": "SS_ROOMS", "class_name": "SurveyRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["LetterRoom"] },
    { "tag": "v3", "new_sqlite_classes": ["RummyRoom"] },
    { "tag": "v4", "new_sqlite_classes": ["DealRoom"] },
    { "tag": "v5", "new_sqlite_classes": ["DiceRoom"] },
    { "tag": "v6", "new_sqlite_classes": ["Board"] },
    { "tag": "v7", "new_sqlite_classes": ["SurveyRoom"] }
  ]
}
